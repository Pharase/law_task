{"nodes": [{"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design", "label": "Google Sheets as the Task Store: Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_sheet_as_source_of_truth", "label": "Google Sheet as Source of Truth for Task Data", "file_type": "rationale", "rationale": "The owner finds Supabase hard to work with and admins sometimes fix things by hand in the sheet, so tasks, sends and buildings live in the sheet; Supabase keeps only logins, invites, files, Ex Docs and notify_log. Performance is not stored but recalculated each time.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_thin_row_store", "label": "Apps Script Thin Row Store (knows tabs and columns, not business rules)", "file_type": "rationale", "rationale": "The script only stores rows; the api function keeps every rule so the tested modules (review.ts, scoring.ts, dates.ts) and the page-facing actions stay unchanged.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_shared_secret_access", "label": "Shared Secret Access (Script API_SECRET == Supabase GSHEET_SECRET)", "file_type": "rationale", "rationale": "The web app is deployed for 'anyone', so a shared secret held only on the server gates it; a wrong secret gets {error:'forbidden'} and nothing is touched. Browsers never call the script.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_compare_and_set_update", "label": "Compare-and-set Update (expect -> conflict)", "file_type": "rationale", "rationale": "The sheet has no transactions; update with expect under LockService replaces the Postgres 'update ... where state = submitted' guards so two admins cannot approve the same send; a conflict maps to the same 409s.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_batch_op_one_lock", "label": "batch Op: Several Steps Under One Lock, All or Nothing", "file_type": "rationale", "rationale": "A send or a review is two writes, so they must run under one lock with no half-written state.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_sheet_layout", "label": "Sheet Layout (Tasks, Sends, Buildings, Members tabs; app vs edit columns; warning-only protection)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_hand_edit_validation", "label": "Row Validation on Every Read (bad rows skipped and reported to admins)", "file_type": "rationale", "rationale": "A bad hand edit must never crash a page: the row is left out of member views and scoring and listed for admins as 'Sheet row N: reason'.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_owner_name_reassignment", "label": "Hand-edited owner_name Is a Reassignment", "file_type": "rationale", "rationale": "If owner_name matches exactly one person, that id wins, owner_id is written back and member_notified_at cleared so the new owner gets a notice; zero or several matches, or an admin, flags the row and leaves owner_id unchanged.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_blank_current_due_on", "label": "Blank current_due_on Falls Back to due_on", "file_type": "rationale", "rationale": "current_due_on stays blank until the first fix round so a hand-corrected due_on flows live into the member's due date, reminders and scoring.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_per_tab_id_counter", "label": "Per-tab Id Counter in Script Properties (never max+1)", "file_type": "rationale", "rationale": "A counter means a deleted row's attachments can never land on a new task that reuses its id.", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L109", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_date_normalization", "label": "Date Cell Normalization to YYYY-MM-DD (Date objects, Buddhist-era years)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_sheet_down_503", "label": "503 'Google Sheet not reachable, try again' (10 s timeout)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_members_mirror", "label": "Members Tab: Read-only Mirror of Supabase profiles", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L86", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_11_08_gsheet_storage_design", "target": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L4", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_gsheet_storage_design", "target": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_sheet_as_source_of_truth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L6", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_gsheet_storage_design", "target": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_thin_row_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-gsheet-storage-design.md", "source_location": "L52", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_gsheet_storage_design", "target": "docs_superpowers_specs_2026_11_08_gsheet_storage_design_sheet_layout", "relation": "references", "confidence": "
{"nodes": [{"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design", "label": "Task Tracking (Button A) and Ex Doc Library (Button C): Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_old_google_sheets_system", "label": "Old Google Sheets + Apps Script System (DB_prohouse.xlsx)", "file_type": "concept", "rationale": "The old system breaks easily (formulas stop at row 1004, fix-round reminders never fire, one blank cell stops all notifications) and keeps the LINE bot token in plain code, which is why law_task replaces it.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_button_a_work", "label": "Button A: Work (assign, send, review, member and admin views)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_task_states", "label": "Task State Machine (on_process, submitted, approved, cancelled)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_review_reasons", "label": "Review Reasons: Wrong-press (void send) vs Needs-fix (scored fix round)", "file_type": "concept", "rationale": "A wrong-press send is recorded but void with no scoring effect and the same due date; a needs-fix review requires fix notes and a new due date and opens a scored fix round. No hard limit on rounds, but after 5 the UI says 'over 5 fix rounds' as the old script did.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_admins_never_own_tasks", "label": "Admins Never Own Tasks and Are Excluded From Performance", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_access_control_in_api", "label": "Access Control Lives in api (public pages, role and ownership check per action)", "file_type": "rationale", "rationale": "Pages are public on GitHub Pages, so a member seeing another member's tasks or a non-admin reaching admin actions can only be prevented by checks inside the api function.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_daily_line_summary", "label": "Daily LINE Summary (one message per person, 09:00 Bangkok weekdays, only if non-empty)", "file_type": "rationale", "rationale": "The bot is on LINE's free plan with a small monthly push limit counted per recipient, so notifications are bundled into one daily summary per person instead of per event; LINE is only a nudge and a failed push must not undo the action.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L106", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_quota_guard", "label": "LINE Quota Guard (check quota, admins first, banner when reached)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_performance_scoring", "label": "Performance Scoring (provisional: on-time, accuracy, task score; month and quarter)", "file_type": "rationale", "rationale": "Formulas are provisional, so all scoring rules live in one pure module with tests and only raw dates and history are stored, never precomputed scores. No rounding at any step; only rounds that actually happened count (the old sheet's empty-slot inflation is deliberately not copied).", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_day_score_formula", "label": "Day Score Formula: 10 if on time, else max(0, 10 - late/3)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L129", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_one_to_five_scale", "label": "1-5 Scale: 1 + 4 x (x - min) / (max - min) Over Members in the Period", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_button_c_ex_doc", "label": "Button C: Ex Doc Library (private exdocs bucket, signed URLs, never auto-deleted)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L174", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_retention_backup_before_delete", "label": "Retention: Backup Before Delete (365 days and backed_up_at set)", "file_type": "rationale", "rationale": "No file may be deleted without a recorded admin backup; the ZIP is built in the admin's browser because of Supabase free-tier function limits, and deleted files keep their database row so timelines still show them.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L181", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_migration_from_old_system", "label": "Migration From the Old System (staff and buildings via local import.sql, not committed)", "file_type": "rationale", "rationale": "Building names are the team's clients and therefore confidential, so they are imported by a git-ignored local script pasted into the SQL Editor rather than a migration in the public repo; old tasks are not imported.", "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L192", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design", "target": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design_old_google_sheets_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-11-08-task-tracking-exdoc-design.md", "source_location": "L7", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_11_08_task_tracking_exdoc_design", "target": "docs_superpowers_specs_2026_11_08_task_tracking_exd